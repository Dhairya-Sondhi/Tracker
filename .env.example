# Canonical public origin used for Supabase password-recovery redirects.
APP_URL=http://localhost:3000

# Find these in Supabase Project Settings > API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-a-supabase-publishable-key
# Server only. Never prefix this key with NEXT_PUBLIC_ or import it into Client Components.
SUPABASE_SECRET_KEY=replace-with-a-supabase-secret-key

# Server-only transactional email. Verify EMAIL_FROM's domain with Resend.
RESEND_API_KEY=replace-with-a-resend-api-key
EMAIL_FROM=Vlocity <notifications@example.com>
# Random value of at least 16 characters, sent as: Authorization: Bearer <value>
CRON_SECRET=replace-with-a-random-cron-secret
