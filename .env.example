# Application database account (runtime DML only)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=form_production
DB_USER=form_app
DB_PASSWORD=replace-with-a-secret-manager-value

# Optional deployment-only account. Keep these variables out of the running app.
DB_MIGRATION_USER=form_migrator
DB_MIGRATION_PASSWORD=replace-with-a-separate-secret-manager-value

# Production: verify_identity. Local MySQL without TLS: disable.
DB_SSL_MODE=disable
# Base64-encoded provider CA certificate; required for verify_identity.
DB_SSL_CA_BASE64=
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000

# Generate a new value for every production environment (minimum 32 characters).
AUTH_SECRET=replace-with-a-cryptographically-random-secret

# Canonical public HTTPS origin used in security-sensitive links.
APP_URL=https://app.example.com

# Transactional password-reset email (server-only).
RESEND_API_KEY=replace-with-a-resend-api-key
AUTH_FROM_EMAIL=Form <security@example.com>

# Supabase server connection. Find these in Project Settings > API Keys.
# Use a new sb_secret_ key when available (legacy service_role also works).
# Never prefix the secret key with NEXT_PUBLIC_ or use it in client components.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-a-supabase-secret-key
